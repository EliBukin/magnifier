<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- COMPATIBLE = a TextureView inside, so a colour filter can be applied to the picture. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/preview_desc"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <bukin.magnifier.FocusRingView
        android:id="@+id/focusRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The frozen picture, over the live one (which keeps running underneath, light and all). -->
    <bukin.magnifier.FrozenView
        android:id="@+id/frozenView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:contentDescription="@string/frozen_desc"
        android:visibility="gone" />

    <!-- While the sharp photo is on its way (the screen's picture shows meanwhile). At the top
         start corner: the top end corner has the About button. -->
    <ProgressBar
        android:id="@+id/photoProgress"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <!-- Short messages: the new colour mode, "saved", problems. Fades by itself. Below the About
         button's row, so a long message never covers it. -->
    <TextView
        android:id="@+id/messageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/panel_background"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:textColor="@color/control_foreground"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Yellow on black"
        tools:visibility="visible" />

    <!-- The panel at the bottom: the lens ring, with what it adjusts and its value inside it, and
         one row of round buttons with Freeze, the biggest, in the middle. Touches on the panel's
         empty parts stop here (ControlPanel), so they never focus the camera under it. -->
    <bukin.magnifier.ControlPanel
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/controls_scrim"
        android:paddingStart="@dimen/panel_side_padding"
        android:paddingTop="@dimen/panel_top_padding"
        android:paddingEnd="@dimen/panel_side_padding"
        android:paddingBottom="@dimen/panel_bottom_padding"
        android:visibility="gone"
        tools:visibility="visible">

        <bukin.magnifier.PanelLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/ringArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Inside the ring: what it adjusts ("Zoom") and its value ("2.50×"). When the
                     ring adjusts brightness or focus, a tap here takes it back to zoom. Under the
                     ring, which only takes touches on its band. -->
                <LinearLayout
                    android:id="@+id/ringCentre"
                    android:layout_width="@dimen/ring_centre_width"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/ring_centre_bottom"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target"
                    android:orientation="vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/ringCaption"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ring_caption_height"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textColor="@color/control_foreground"
                        android:textSize="15sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeTextType="uniform"
                        tools:text="Zoom" />

                    <TextView
                        android:id="@+id/ringValue"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ring_value_height"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textColor="@color/accent"
                        android:textDirection="ltr"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="36sp"
                        app:autoSizeMinTextSize="16sp"
                        app:autoSizeTextType="uniform"
                        tools:text="2.50×" />
                </LinearLayout>

                <bukin.magnifier.LensRingView
                    android:id="@+id/lensRing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <!-- Live: brightness, light, FREEZE, focus, colours. Frozen: brightness, save, LIVE,
                 share, colours (in the light's and the focus's places). Freeze rises into the ring. -->
            <LinearLayout
                android:id="@+id/actionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/freeze_rise"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <!-- Puts brightness on the ring; shows the level ("+3"). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/brightnessButton"
                    style="@style/Widget.Magnifier.RoundButton"
                    android:contentDescription="@string/ring_brightness"
                    android:textDirection="ltr"
                    app:icon="@drawable/ic_brightness_up"
                    tools:text="0" />

                <Space style="@style/Widget.Magnifier.RowGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lightButton"
                    style="@style/Widget.Magnifier.RoundButton"
                    android:contentDescription="@string/light_desc"
                    android:text="@string/light_button"
                    app:icon="@drawable/ic_light_off" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    style="@style/Widget.Magnifier.RoundButton"
                    android:contentDescription="@string/save_desc"
                    android:text="@string/save_button"
                    android:visibility="gone"
                    app:icon="@drawable/ic_save" />

                <Space style="@style/Widget.Magnifier.RowGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/freezeButton"
                    style="@style/Widget.Magnifier.FreezeButton"
                    android:text="@string/freeze_button"
                    app:icon="@drawable/ic_freeze" />

                <Space style="@style/Widget.Magnifier.RowGap" />

                <!-- The focus mode: Auto, Locked (after a tap on the picture) or Manual (the ring). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/focusButton"
                    style="@style/Widget.Magnifier.RoundButton"
                    android:contentDescription="@string/focus_desc"
                    android:text="@string/focus_auto"
                    app:icon="@drawable/ic_focus_auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    style="@style/Widget.Magnifier.RoundButton"
                    android:contentDescription="@string/share_desc"
                    android:text="@string/share_button"
                    android:visibility="gone"
                    app:icon="@drawable/ic_share" />

                <Space style="@style/Widget.Magnifier.RowGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/colourButton"
                    style="@style/Widget.Magnifier.RoundButton"
                    android:contentDescription="@string/colour_desc"
                    android:text="@string/colour_short_normal"
                    app:icon="@drawable/ic_colour" />
            </LinearLayout>
        </bukin.magnifier.PanelLayout>
    </bukin.magnifier.ControlPanel>

    <!-- When the camera can't start: what happened, and "Try again" where that can help. -->
    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/panel_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/control_foreground"
            android:textSize="22sp"
            tools:text="@string/error_in_use" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/errorRetry"
            style="@style/Widget.Magnifier.BigButton"
            android:layout_marginTop="24dp"
            android:text="@string/error_try_again" />
    </LinearLayout>

    <!-- The camera permission: an explanation first, then what to do if it was denied. -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/permissionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/control_foreground"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="@string/permission_explain_title" />

        <TextView
            android:id="@+id/permissionBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/control_foreground"
            android:textSize="22sp"
            tools:text="@string/permission_explain_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/permissionButton"
            style="@style/Widget.Magnifier.BigButton"
            android:layout_marginTop="32dp"
            tools:text="@string/permission_continue" />
    </LinearLayout>

    <!-- About and privacy: the top end corner, clear of the status bar (insets in MainActivity)
         and far from the panel. Last, so it stays on top of every panel, the permission screen
         included: the privacy policy is one tap away before the camera is allowed. -->
    <ImageButton
        android:id="@+id/aboutButton"
        android:layout_width="@dimen/about_button"
        android:layout_height="@dimen/about_button"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/about_button_margin"
        android:layout_marginEnd="@dimen/about_button_margin"
        android:background="@drawable/about_button_background"
        android:contentDescription="@string/about_button_desc"
        android:scaleType="center"
        android:src="@drawable/ic_info" />
</FrameLayout>
