    <!-- Camera permission -->
    <string name="permission_explain_title">גישה למצלמה</string>
    <string name="permission_explain_body">Bukin Magnifier מציגה את התמונה של המצלמה האחורית, מוגדלת. לשם כך היא צריכה את המצלמה. התמונה נשארת בטלפון: לאפליקציה אין גישה לאינטרנט.</string>
    <string name="permission_continue">המשך</string>
    <string name="permission_denied_title">הזכוכית המגדלת צריכה את המצלמה</string>
    <string name="permission_denied_body">בלי המצלמה אין מה להגדיל. יש להקיש על \"מתן הרשאה\" כדי לאפשר אותה.</string>
    <string name="permission_grant">מתן הרשאה</string>
    <string name="permission_blocked_body">המצלמה כבויה עבור האפליקציה הזו. יש לפתוח את הגדרות האפליקציה, להקיש על \"הרשאות\" ולאפשר את \"מצלמה\".</string>
    <string name="permission_open_settings">פתיחת ההגדרות</string>

