<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark: the camera picture is the screen, and white panels would dazzle. -->
    <style name="Theme.Magnifier" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
    </style>

    <!-- The round buttons beside Freeze (brightness, light, focus, colours; frozen: save, share):
         a circle with the icon, and the word under it on the dark panel. One view, so the circle
         and the word are one touch target: the background is inset at the bottom (and sides), and
         the icon gap puts the word below the circle. Material 3 buttons are fully rounded, so the
         square inset background is a circle. The word is always white (see paintStateButton). -->
    <style name="Widget.Magnifier.RoundButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">@dimen/side_button_width</item>
        <item name="android:layout_height">@dimen/side_button_height</item>
        <item name="android:minWidth">@dimen/side_button_width</item>
        <item name="android:minHeight">@dimen/side_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">@dimen/side_label_height</item>
        <item name="android:insetLeft">@dimen/side_circle_inset</item>
        <item name="android:insetRight">@dimen/side_circle_inset</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">@dimen/side_icon_top</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">14sp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">@dimen/side_icon_gap</item>
        <item name="iconSize">@dimen/side_icon</item>
        <item name="backgroundTint">@color/control_background</item>
        <item name="android:textColor">@color/control_foreground</item>
        <item name="iconTint">@color/control_foreground</item>
        <item name="strokeColor">@color/control_foreground</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Freeze / Live: the main action, the biggest circle, in the accent colour, its word inside. -->
    <style name="Widget.Magnifier.FreezeButton" parent="Widget.Magnifier.RoundButton">
        <item name="android:layout_width">@dimen/freeze_button</item>
        <item name="android:layout_height">@dimen/freeze_button</item>
        <item name="android:minWidth">@dimen/freeze_button</item>
        <item name="android:minHeight">@dimen/freeze_button</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">17sp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">36dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="strokeColor">@color/accent</item>
    </style>

    <!-- The even gaps between the buttons in the row. -->
    <style name="Widget.Magnifier.RowGap" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <!-- The one big action on a panel ("Continue", "Grant", "Try again"). -->
    <style name="Widget.Magnifier.BigButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">22sp</item>
    </style>
</resources>
