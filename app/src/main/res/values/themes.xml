<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark: the camera picture is the screen, and white panels would dazzle. -->
    <style name="Theme.Magnifier" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
    </style>

    <!-- The square zoom buttons beside the slider: an icon only, 64dp. -->
    <style name="Widget.Magnifier.ZoomButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">32dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="backgroundTint">@color/control_background</item>
        <item name="iconTint">@color/control_foreground</item>
    </style>

    <!-- The action tiles (colours, light, focus, save, share): an icon over a word, 76dp tall. -->
    <style name="Widget.Magnifier.Tile" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/tile_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">15sp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">15sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">2dp</item>
        <item name="iconSize">30dp</item>
        <item name="backgroundTint">@color/control_background</item>
        <item name="android:textColor">@color/control_foreground</item>
        <item name="iconTint">@color/control_foreground</item>
        <item name="strokeColor">@color/control_foreground</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Freeze / Live: the main action, wider than the other tiles and in the accent colour. -->
    <style name="Widget.Magnifier.FreezeButton" parent="Widget.Magnifier.Tile">
        <item name="android:layout_weight">1.7</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="autoSizeMinTextSize">14sp</item>
        <item name="autoSizeMaxTextSize">20sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconSize">34dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="strokeColor">@color/accent</item>
    </style>

    <!-- The adjust tabs (zoom, brightness, focus) above the slider: the chosen one is yellow. -->
    <style name="Widget.Magnifier.Tab" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/tab_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">18sp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">22sp</item>
        <item name="backgroundTint">@color/tab_background</item>
        <item name="android:textColor">@color/tab_foreground</item>
        <item name="strokeColor">@color/control_foreground</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- A slider with a button at each end. -->
    <style name="Widget.Magnifier.SliderRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- The zoom and focus sliders. Height = the thumb plus the top and bottom padding: 36 + 2 x 14 = 64dp. -->
    <style name="Widget.Magnifier.BigSlider" parent="Widget.Material3.Slider">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:valueFrom">0</item>
        <item name="android:valueTo">100</item>
        <item name="haloRadius">28dp</item>
        <item name="labelBehavior">gone</item>
        <item name="minTouchTargetSize">@dimen/touch_target</item>
        <item name="thumbHeight">36dp</item>
        <item name="thumbTrackGapSize">0dp</item>
        <item name="thumbWidth">36dp</item>
        <item name="trackHeight">12dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="tickVisible">false</item>
    </style>

    <!-- The one big action on a panel ("Continue", "Grant", "Try again"). -->
    <style name="Widget.Magnifier.BigButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">22sp</item>
    </style>
</resources>
