<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark: the camera picture is the screen, and white panels would dazzle. -->
    <style name="Theme.Magnifier" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
    </style>

    <!-- The square zoom buttons beside the slider: an icon only, 64dp. -->
    <style name="Widget.Magnifier.ZoomButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">32dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="backgroundTint">@color/control_background</item>
        <item name="iconTint">@color/control_foreground</item>
    </style>

    <!-- The light and focus buttons: an icon and a word ("Light", "Auto"), 64dp tall. -->
    <style name="Widget.Magnifier.StateButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/state_button_min_width</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:maxLines">1</item>
        <item name="cornerRadius">32dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">28dp</item>
        <item name="strokeColor">@color/control_foreground</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- The zoom and focus sliders. Height = the thumb plus the top and bottom padding: 36 + 2 x 14 = 64dp. -->
    <style name="Widget.Magnifier.BigSlider" parent="Widget.Material3.Slider">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:valueFrom">0</item>
        <item name="android:valueTo">100</item>
        <item name="haloRadius">28dp</item>
        <item name="labelBehavior">gone</item>
        <item name="minTouchTargetSize">@dimen/touch_target</item>
        <item name="thumbHeight">36dp</item>
        <item name="thumbTrackGapSize">0dp</item>
        <item name="thumbWidth">36dp</item>
        <item name="trackHeight">12dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <!-- The one big action on a panel ("Continue", "Grant", "Try again"). -->
    <style name="Widget.Magnifier.BigButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">22sp</item>
    </style>
</resources>
