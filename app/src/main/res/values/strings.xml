<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Bukin Magnifier</string>

    <!-- Camera permission -->
    <string name="permission_explain_title">Camera access</string>
    <string name="permission_explain_body">Bukin Magnifier shows the rear camera\'s picture, enlarged. It needs the camera for that. The picture stays on your phone: the app has no internet access.</string>
    <string name="permission_continue">Continue</string>
    <string name="permission_denied_title">The magnifier needs the camera</string>
    <string name="permission_denied_body">Without the camera there is nothing to magnify. Tap Grant to allow it.</string>
    <string name="permission_grant">Grant</string>
    <string name="permission_blocked_body">The camera is turned off for this app. Open the app\'s settings, tap Permissions, and allow Camera.</string>
    <string name="permission_open_settings">Open settings</string>

    <!-- Camera picture -->
    <string name="preview_desc">Camera picture. Tap to focus there and lock it.</string>

    <!-- Zoom. %1$s is the zoom: two decimals below 2 (1.25), one from 2 up (3.2). -->
    <string name="zoom_label">%1$s×</string>
    <string name="zoom_spoken">Zoom %1$s times</string>
    <string name="zoom_slider_desc">Zoom</string>
    <string name="zoom_in_desc">Zoom in</string>
    <string name="zoom_out_desc">Zoom out</string>
    <string name="zoom_unavailable">No zoom</string>

    <!-- The LED light -->
    <string name="light_button">Light</string>
    <string name="light_desc">Light</string>
    <string name="light_none">No light</string>
    <string name="light_none_desc">Light not available: this phone\'s rear camera has no flash</string>
    <string name="state_on">On</string>
    <string name="state_off">Off</string>

    <!-- Focus. The button shows the mode; TalkBack says "Focus, Auto". -->
    <string name="focus_desc">Focus</string>
    <string name="focus_auto">Auto</string>
    <string name="focus_locked">Locked</string>
    <string name="focus_manual">Manual</string>
    <string name="focus_action_lock">lock the focus on the middle of the picture</string>
    <string name="focus_action_auto">go back to auto focus</string>
    <!-- The focus slider, near to far (only on phones that support manual focus) -->
    <string name="focus_slider_desc">Focus distance</string>
    <string name="focus_near_desc">Focus nearer</string>
    <string name="focus_far_desc">Focus farther</string>
    <string name="focus_spoken_far">Far</string>
    <plurals name="focus_spoken_cm">
        <item quantity="one">%1$d centimetre</item>
        <item quantity="other">%1$d centimetres</item>
    </plurals>
    <string name="focus_spoken_m">%1$s metres</string>
    <string name="focus_spoken_percent">%1$d%% of the way to far</string>

    <!-- The adjust tabs: which control the slider row shows. The zoom tab shows the zoom ("1.25×"). -->
    <string name="tab_brightness">Brightness</string>
    <string name="tab_focus">Focus</string>

    <!-- Brightness: the camera\'s exposure live, the picture\'s brightness when frozen. -->
    <string name="brightness_slider_desc">Brightness</string>
    <string name="brightness_down_desc">Darker</string>
    <string name="brightness_up_desc">Lighter</string>
    <string name="brightness_normal">Normal</string>
    <plurals name="brightness_lighter">
        <item quantity="one">%1$d step lighter</item>
        <item quantity="other">%1$d steps lighter</item>
    </plurals>
    <plurals name="brightness_darker">
        <item quantity="one">%1$d step darker</item>
        <item quantity="other">%1$d steps darker</item>
    </plurals>
    <string name="brightness_unavailable">This camera can\'t change the brightness. Freeze the picture to brighten it.</string>

    <!-- Colour modes. The button shows the short name; TalkBack says "Colours, Yellow on black". -->
    <string name="colour_desc">Colours</string>
    <string name="colour_action">change the colours</string>
    <string name="colour_normal">Normal</string>
    <string name="colour_high_contrast">High contrast</string>
    <string name="colour_inverted">Inverted</string>
    <string name="colour_yellow_on_black">Yellow on black</string>
    <string name="colour_short_normal">Normal</string>
    <string name="colour_short_high_contrast">Contrast</string>
    <string name="colour_short_inverted">Inverted</string>
    <string name="colour_short_yellow_on_black">Yellow</string>

    <!-- Freeze. The button says what a tap does: "Freeze" while live, "Live" while frozen. -->
    <string name="freeze_button">Freeze</string>
    <string name="live_button">Live</string>
    <string name="freeze_action">freeze the picture</string>
    <string name="live_action">go back to the moving picture</string>
    <string name="frozen_state">Picture frozen</string>
    <string name="frozen_desc">Frozen picture. Pinch or double tap to zoom, drag to move around.</string>
    <string name="photo_failed">Couldn\'t take a sharp photo. This is the picture from the screen.</string>

    <!-- Save and share (frozen picture only). They take the whole picture, not just the zoomed part. -->
    <string name="save_button">Save</string>
    <string name="save_desc">Save the whole picture</string>
    <string name="share_button">Share</string>
    <string name="share_desc">Share the whole picture</string>
    <string name="share_chooser_title">Share the picture</string>
    <string name="saved_message">The whole picture is saved in Pictures, Bukin Magnifier.</string>
    <string name="save_failed">Couldn\'t save the picture.</string>
    <string name="share_failed">Couldn\'t share the picture.</string>
    <string name="save_permission_denied">To save pictures, allow the app to store them.</string>
    <string name="save_permission_blocked">Storage is turned off for this app. To save pictures, allow it in the app\'s settings.</string>

    <!-- When the camera can't start -->
    <string name="error_no_camera">This phone has no rear camera, so the magnifier can\'t work.</string>
    <string name="error_in_use">Another app is using the camera. Close it, then tap Try again.</string>
    <string name="error_disabled">The camera is blocked on this phone right now. Tap Try again.</string>
    <string name="error_dnd">Do Not Disturb is blocking the camera. Turn it off, then tap Try again.</string>
    <string name="error_generic">The camera couldn\'t start. Tap Try again.</string>
    <string name="error_try_again">Try again</string>
</resources>
